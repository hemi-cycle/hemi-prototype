---
// Figma "Key-numbers" — vérifié via les instances du votes-wrapper du Law-card
// (node 2597:23663) et de la section vote de la page détail (node 2583:18130).
// Seule la taille "compact" (55px) a été observée dans le fichier ; "comfortable"
// est une extrapolation raisonnable, à confirmer visuellement si un jour utilisée.
// Le thème "on-dark" (fond overlay-light-20, texte blanc) correspond à l'usage dans
// le "Chart Container" brand-darker du node 2583:18130 ; "on-light" (défaut) à
// l'usage sur les cartes claires du reste de la page.
export type KeyNumberState = 'default' | 'success' | 'failure' | 'warning';
export type KeyNumberSize = 'compact' | 'comfortable';
export type KeyNumberTheme = 'on-light' | 'on-dark';
// Même légende (cercle + hachure) que VotesMajorityBar/HemicycleChartV2 : "nw" = \
// (Pour), "ne" = / (Contre), "horizontal" (Abstention), aucune hachure + bordure
// intérieure pour Non-votant (dotBordered) — un seul vocabulaire visuel pour les
// 3 dataviz du module Votes & Hémicycle plutôt qu'un code cercle/carré/triangle par
// composant.
export type KeyNumberDotStripe = 'nw' | 'ne' | 'horizontal' | 'vertical';

interface Props {
  value: number | string;
  label: string;
  state?: KeyNumberState;
  size?: KeyNumberSize;
  theme?: KeyNumberTheme;
  valueId?: string;
  dot?: boolean;
  dotStripe?: KeyNumberDotStripe;
  dotBordered?: boolean;
}

const { value, label, state = 'default', size = 'compact', theme = 'on-light', valueId, dot = false, dotStripe, dotBordered = false } = Astro.props;

const stripeAngle: Record<KeyNumberDotStripe, number> = {
  nw: 45,
  ne: 135,
  horizontal: 0,
  vertical: 90,
};

const stateColor: Record<KeyNumberTheme, Record<KeyNumberState, string>> = {
  'on-light': {
    default: 'var(--color-text-default)',
    success: 'var(--color-success-on-light)',
    failure: 'var(--color-error-on-light)',
    warning: 'var(--color-warning-on-light)',
  },
  'on-dark': {
    default: 'var(--color-text-white)',
    success: 'var(--color-success-on-dark)',
    failure: 'var(--color-error-on-dark)',
    warning: 'var(--color-warning-on-dark)',
  },
};

// Encre toujours sombre (contrairement au Contre de VotesMajorityBar, qui utilise du
// blanc) : ici les couleurs "-on-dark" (success/error/warning) sont toutes des tons
// pastel clairs, pas le rouge saturé --color-error-on-light — une hachure sombre reste
// donc lisible sur les 3.
const dotColor = dotBordered ? 'white' : stateColor[theme][state];
const dotStripeCss = dotStripe
  ? `background-image: repeating-linear-gradient(${stripeAngle[dotStripe]}deg, rgba(0, 0, 0, 0.2) 0, rgba(0, 0, 0, 0.2) 1.5px, transparent 1.5px, transparent 5px);`
  : '';
const dotBorderCss = dotBordered ? `box-shadow: inset 0 0 0 1px var(--color-border-neutral-secondary);` : '';
const dotStyle = `background-color:${dotColor};${dotStripeCss}${dotBorderCss}`;
---

<div class={`key-number key-number--${size} key-number--${theme}`}>
  <p class="key-number__value" id={valueId} style={`color:${stateColor[theme][state]}`}>{value}</p>
  <p class="key-number__label">
    {dot && <span class="key-number__dot" style={dotStyle} aria-hidden="true"></span>}
    {label}
  </p>
</div>

<style>
  .key-number {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    border-radius: var(--radius-extra-small);
  }

  .key-number--on-light {
    background: #fff;
  }

  .key-number--on-dark {
    background: var(--color-overlay-light-20);
  }

  .key-number--on-dark .key-number__label {
    color: var(--color-text-white);
  }

  .key-number--compact {
    padding: var(--space-4xs) var(--space-xs) var(--space-3xs);
  }

  .key-number--compact .key-number__value {
    font-size: var(--text-body-small);
  }

  .key-number--comfortable {
    padding: var(--space-2xs) var(--space-sm) var(--space-2xs);
  }

  .key-number--comfortable .key-number__value {
    font-size: var(--text-h1);
  }

  .key-number__value {
    font-family: var(--font-heading);
    font-weight: 400;
    margin: 0;
    line-height: normal;
  }

  .key-number__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4xs);
    font-family: var(--font-body);
    font-size: var(--text-body-xsmall);
    color: var(--color-text-default);
    text-transform: uppercase;
    margin: 0;
  }

  .key-number__dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
</style>
