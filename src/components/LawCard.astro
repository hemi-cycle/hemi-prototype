---
// Reproduit Law-card/Master (Figma node 2597:23663), composé à partir des primitives DS.
// Les tags thématiques restent statiques pour l'instant — à rendre data-driven plus tard.
import Tag from './Tag.astro';
import LawStateTag from './LawStateTag.astro';
import Avatar from './Avatar.astro';

interface Props {
  id: string;
  titre: string;
  sousTitre: string;
  statut: string;
  deposantNom: string;
  deposantRole: string;
}

const { id, titre, sousTitre, statut, deposantNom, deposantRole } = Astro.props;

const tags = [
  { label: 'Agriculture', icon: 'plant' },
  { label: 'Écologie', icon: 'tree' },
];
---

<a href={`${import.meta.env.BASE_URL}/loi/${id}`} class="law-card">
  <div class="header">
    <div class="title-block">
      <h2 class="title">{titre}</h2>
      <p class="subtitle">{sousTitre}</p>
    </div>
    <div class="theme-wrapper">
      <LawStateTag statut={statut} />
      {tags.map((tag) => <Tag label={tag.label} leading="icon" icon={tag.icon} />)}
    </div>
  </div>

  <div class="divider"></div>

  <div class="list-item">
    <Avatar size={40} showBorder name={deposantNom} />
    <div class="list-item__content">
      <p class="list-item__label">{deposantNom}</p>
      <p class="list-item__supporting">{deposantRole}</p>
    </div>
  </div>
</a>

<style>
  .law-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--color-bg-neutral-primary);
    border: 0.5px solid var(--color-bg-neutral-tertiary);
    border-radius: var(--radius-small);
    box-shadow: var(--elevation-3);
    overflow: hidden;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-xs) var(--space-3xs);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xs);
  }

  .title {
    font-family: var(--font-heading);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .subtitle {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    line-height: 20px;
    color: var(--color-text-dark-grey);
    margin: 0;
  }

  .theme-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4xs);
  }

  .divider {
    height: 0.5px;
    background: var(--color-bg-neutral-tertiary);
  }

  .list-item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 48px;
    padding: var(--space-2xs) var(--space-xs);
  }

  .list-item__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .list-item__label {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    color: var(--color-text-default);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .list-item__supporting {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text-dark-grey);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
