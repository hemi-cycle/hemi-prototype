---
// Dataviz hémicycle — anciennement "V2" comparée à HemicycleChart.astro (retirée,
// voir CLAUDE.md discussion), c'est maintenant l'unique implémentation. Toujours
// 1 point = 1 siège réel. Deux partis pris hérités de cette comparaison :
// 1. Assignation des catégories par balayage global gauche->droite (hemicycle-layout-v2.ts)
//    au lieu d'une répartition proportionnelle rangée par rangée : donne un bloc plein
//    par catégorie, plus proche d'une vraie photo d'hémicycle.
// 2. Une légende (obligatoire dès qu'il y a >= 2 séries) et un <title> par point pour
//    un tooltip natif au survol — "1 point = 1 siège" doit être inspectable, pas
//    seulement décoratif.
import type { VoteStep } from '../data/votes-mock';
import { generateHemicycleLayoutV2 } from '../lib/hemicycle-layout-v2';
import { DOT_SIZE } from '../lib/hemicycle-layout';

interface Props {
  votes: VoteStep[];
  activeVoteId: string;
}

const { votes, activeVoteId } = Astro.props;

const activeVote = votes.find((v) => v.id === activeVoteId) ?? votes[votes.length - 1];

const byChambre = new Map<string, VoteStep[]>();
for (const vote of votes) {
  byChambre.set(vote.chambre, [...(byChambre.get(vote.chambre) ?? []), vote]);
}

// L'AN (577 sièges, rayon extérieur ~208) et le Sénat (348, ~160) partagent le même
// viewBox "max" (voir chartMaxWidth/Height plus bas) : l'hémicycle le plus petit
// (Sénat) est donc mécaniquement agrandi par preserveAspectRatio pour remplir le
// même conteneur, ce qui grossit AUSSI ses points au passage. À DOT_SIZE égal, les
// points de l'AN paraissent donc plus petits à l'écran que ceux du Sénat — on
// compense en augmentant le DOT_SIZE de l'AN.
const AN_DOT_SIZE = Math.round(DOT_SIZE * 1.3 * 10) / 10;

const chambreCharts = Array.from(byChambre.entries()).map(([chambre, steps]) => {
  const totalSieges = steps[steps.length - 1].totalSieges;
  const isActive = chambre === activeVote.chambre;
  const initialCounts = isActive ? activeVote : steps[steps.length - 1];
  const dotSize = chambre === 'assemblee_nationale' ? AN_DOT_SIZE : DOT_SIZE;
  const layout = generateHemicycleLayoutV2(totalSieges, initialCounts, dotSize);
  return { chambre, layout, isActive };
});

// AN (577 sièges) et Sénat (348) ont des viewBox de tailles différentes (rayon
// extérieur différent). Sans ça, chaque <svg> gardait son propre ratio via
// height:auto et le conteneur changeait de hauteur au clic sur un vote d'une autre
// chambre (la carte "sautait" verticalement). On réserve donc la hauteur de la PLUS
// GRANDE chambre (toujours l'AN dans ce jeu de données) pour les deux <svg> : le plus
// petit hémicycle (Sénat) est alors juste légèrement "lettreboxé" par
// preserveAspectRatio au lieu de forcer une hauteur de carte différente.
const chartMaxWidth = Math.max(...chambreCharts.map((chart) => chart.layout.width));
const chartMaxHeight = Math.max(...chambreCharts.map((chart) => chart.layout.height));
---

<div class="hemicycle-v2">
  <svg width="0" height="0" aria-hidden="true" focusable="false" class="hemicycle-v2__defs">
    <defs>
      <!-- Même hachure/couleurs que VotesMajorityBar (identité Pour/Contre par
           orientation 45°/135°, pas seulement par couleur, pour les daltoniens) —
           un seul <defs> partagé par les deux <svg> par chambre ci-dessous.
           ATTENTION : CSS repeating-linear-gradient(Ndeg) et SVG patternTransform
           "rotate(N)" sur une hachure verticale ne donnent PAS la même orientation
           visuelle pour le même N (une bande de gradient est perpendiculaire à son
           axe, un rect vertical tourné suit directement l'angle) — d'où le rotate()
           inversé (135/45) ici par rapport aux 45deg/135deg CSS de VotesMajorityBar,
           pour obtenir le même "\" (pour) / "/" (contre) à l'écran dans les deux. -->
      <pattern id="hemicycle-stripe-pour" patternUnits="userSpaceOnUse" width="3" height="3" patternTransform="rotate(135)">
        <rect class="hemicycle-v2__stripe-bg hemicycle-v2__stripe-bg--pour" width="3" height="3" />
        <rect class="hemicycle-v2__stripe-ink" width="1.5" height="3" />
      </pattern>
      <pattern id="hemicycle-stripe-contre" patternUnits="userSpaceOnUse" width="3" height="3" patternTransform="rotate(45)">
        <rect class="hemicycle-v2__stripe-bg hemicycle-v2__stripe-bg--contre" width="3" height="3" />
        <rect class="hemicycle-v2__stripe-ink hemicycle-v2__stripe-ink--contre" width="1.5" height="3" />
      </pattern>
      <!-- Abstention (horizontal) — même rect vertical de base que pour/contre,
           tourné de 90°. Non-votant reste blanc plein + bordure, sans hachure. -->
      <pattern id="hemicycle-stripe-abstention" patternUnits="userSpaceOnUse" width="3" height="3" patternTransform="rotate(90)">
        <rect class="hemicycle-v2__stripe-bg hemicycle-v2__stripe-bg--abstention" width="3" height="3" />
        <rect class="hemicycle-v2__stripe-ink" width="1.5" height="3" />
      </pattern>
    </defs>
  </svg>

  <div class="hemicycle-v2__stack">
    <div class="hemicycle-v2__chart" style={`aspect-ratio: ${chartMaxWidth} / ${chartMaxHeight};`}>
    {chambreCharts.map((chart) => (
      <svg
        class="hemicycle-v2__svg"
        data-chambre={chart.chambre}
        viewBox={`0 0 ${chart.layout.width} ${chart.layout.height}`}
        width={chart.layout.width}
        height={chart.layout.height}
        hidden={!chart.isActive}
        role="img"
        aria-label={`Hémicycle : ${activeVote.pour} pour, ${activeVote.contre} contre, ${activeVote.abstention} abstentions, ${activeVote.nonVotant} non-votants sur ${activeVote.totalSieges} sièges.`}
      >
        {chart.layout.points.map((point, index) => (
          <circle
            class="hemicycle-v2__dot"
            data-index={index}
            data-vote={point.category}
            cx={point.x}
            cy={point.y}
            r={chart.layout.dotSize / 2}
          >
            <title>Siège {index + 1} — {point.category}</title>
          </circle>
        ))}
      </svg>
    ))}
    </div>

    <div class="hemicycle-v2__center-label">
      <p class="hemicycle-v2__seats" id="hemicycle-v2-seats">{activeVote.totalSieges}</p>
      <p class="hemicycle-v2__caption">sièges</p>
    </div>
  </div>
</div>

<style>
  .hemicycle-v2 {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--space-2xs);
  }

  .hemicycle-v2__stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3xs);
    width: 100%;
    background: white;
    border-radius: var(--radius-full) var(--radius-full) 20px 20px;
    overflow: hidden;
  }

  .hemicycle-v2__chart {
    box-sizing: border-box;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    /* box-sizing:border-box est nécessaire ici : sans lui (comportement par défaut du
       navigateur, aucun reset global box-sizing dans le projet), le padding s'AJOUTE
       à width:100% au lieu d'être soustrait du contenu — la carte devient plus large
       que son parent .hemicycle-v2__stack, d'où le padding "sans effet" et le
       dataviz qui débordait de la carte. */
    padding: var(--space-2xs);
    padding-bottom: 0;
  }

  .hemicycle-v2__svg {
    display: block;
    width: 100%;
    max-width: 100%;
    /* height:100% (au lieu de auto) + aspect-ratio fixe sur .hemicycle-v2__chart
       (voir le style inline posé depuis le frontmatter) : chaque <svg> garde son
       propre viewBox/ratio interne (via preserveAspectRatio par défaut), mais le
       conteneur, lui, ne change plus de hauteur selon la chambre active. */
    height: 100%;
    min-width: 0;
  }

  .hemicycle-v2__svg[hidden] {
    display: none;
  }

  .hemicycle-v2__dot[data-vote='pour'] {
    fill: url(#hemicycle-stripe-pour);
  }

  .hemicycle-v2__dot[data-vote='contre'] {
    fill: url(#hemicycle-stripe-contre);
  }

  .hemicycle-v2__stripe-bg--pour {
    fill: var(--color-success-on-light);
  }

  .hemicycle-v2__stripe-bg--contre {
    fill: var(--color-error-on-light);
  }

  .hemicycle-v2__stripe-ink {
    fill: rgba(0, 0, 0, 0.2);
  }

  .hemicycle-v2__stripe-ink--contre {
    fill: rgba(255, 255, 255, 0.3);
  }

  .hemicycle-v2__stripe-bg--abstention {
    fill: var(--color-warning-on-light);
  }

  .hemicycle-v2__dot[data-vote='abstention'] {
    fill: url(#hemicycle-stripe-abstention);
  }

  .hemicycle-v2__dot[data-vote='non-votant'] {
    fill: white;
    stroke: var(--color-border-neutral-secondary);
    stroke-width: 1;
  }

  .hemicycle-v2__center-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 var(--space-sm) 10px;
    margin-top: -30px;
  }

  .hemicycle-v2__seats {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .hemicycle-v2__caption {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    color: var(--color-text-default);
    margin: 0;
  }

</style>
