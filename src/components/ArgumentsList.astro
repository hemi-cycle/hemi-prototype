---
// "Les arguments en débat" (Figma node 2583:18064, US-5 backlog).
// La maquette montre aussi des Chip de filtrage par motivation ("Pour les petits
// producteurs", "Pour l'agro-industrie"...) — pas implémentés ici : notre JSON n'a
// que 2 listes pour/contre, pas de catégorisation par argument. Voir roadmap.
import Icon from './Icon.astro';

interface Props {
  pour: string[];
  contre: string[];
}

const { pour, contre } = Astro.props;
---

<div class="arguments">
  <h2 class="arguments__title">Les arguments en débat</h2>

  <div class="arguments__group">
    <div class="arguments__header arguments__header--pour">
      <Icon name="check-circle" size={24} color="var(--color-success-on-light)" />
      <span>POUR</span>
    </div>
    <ul class="arguments__list">
      {pour.map((argument) => <li><h3 class="arguments__item">{argument}</h3></li>)}
    </ul>
  </div>

  <div class="arguments__group">
    <div class="arguments__header arguments__header--contre">
      <Icon name="x-circle" size={24} color="var(--color-error-on-light)" />
      <span>CONTRE</span>
    </div>
    <ul class="arguments__list">
      {contre.map((argument) => <li><h3 class="arguments__item">{argument}</h3></li>)}
    </ul>
  </div>
</div>

<style>
  .arguments {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-xs) var(--space-md);
    background: var(--color-bg-neutral-primary);
    border-radius: var(--radius-small);
  }

  .arguments__title {
    font-family: var(--font-heading);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .arguments__group {
    border: 1px solid var(--color-border-neutral-secondary);
    border-radius: var(--radius-small);
    overflow: hidden;
  }

  .arguments__header {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--text-body-large);
    font-weight: 500;
  }

  .arguments__header--pour {
    background: var(--color-success-light);
    color: var(--color-success-on-light);
  }

  .arguments__header--contre {
    background: var(--color-error-light);
    color: var(--color-error-on-light);
  }

  .arguments__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: var(--color-border-neutral-secondary);
  }

  .arguments__list li {
    padding: var(--space-2xs);
    background: var(--color-bg-neutral-primary);
  }

  .arguments__item {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 400;
    line-height: 20px;
    color: var(--color-text-default);
  }
</style>
