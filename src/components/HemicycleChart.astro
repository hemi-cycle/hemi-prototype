---
// "Dataviz hémicycle" (Figma node 2583:18159, dans le "Chart Container" du node
// 2583:18131) — voir "MD plans/Hemi_Plan_Votes_Hemicycle.md" §3-§6.
// 1 point = 1 siège réel (577 AN / 348 Sénat), généré via hemicycle-layout.ts,
// au lieu des 204 points fixes/décoratifs de la maquette. Un <svg> par chambre est
// pré-rendu (positions calculées une seule fois, au build) ; seul celui de la chambre
// active est visible. Le clic sur un item de VotesTimeline (script en fin de page)
// ne fait que changer l'attribut `data-vote` de chaque point déjà positionné et
// basculer quel <svg> est visible — aucun recalcul de layout côté client.
import type { VoteStep } from '../data/votes-mock';
import { generateHemicycleLayout, DOT_SIZE } from '../lib/hemicycle-layout';

interface Props {
  votes: VoteStep[];
  activeVoteId: string;
}

const { votes, activeVoteId } = Astro.props;

const activeVote = votes.find((v) => v.id === activeVoteId) ?? votes[votes.length - 1];

function seuilMajorite(totalSieges: number) {
  return Math.floor(totalSieges / 2) + 1;
}

const byChambre = new Map<string, VoteStep[]>();
for (const vote of votes) {
  byChambre.set(vote.chambre, [...(byChambre.get(vote.chambre) ?? []), vote]);
}

// Chaque chambre a un total de sièges constant : on prend le dernier step connu.
// La chambre active est catégorisée avec le vote sélectionné ; les autres avec leur
// dernier step (elles sont masquées de toute façon tant qu'on ne clique pas dessus).
const chambreCharts = Array.from(byChambre.entries()).map(([chambre, steps]) => {
  const totalSieges = steps[steps.length - 1].totalSieges;
  const isActive = chambre === activeVote.chambre;
  const initialCounts = isActive ? activeVote : steps[steps.length - 1];
  const layout = generateHemicycleLayout(totalSieges, initialCounts);
  return { chambre, layout, isActive };
});
---

<div class="hemicycle">
  <div class="hemicycle__chart">
    {chambreCharts.map((chart) => (
      <svg
        class="hemicycle__svg"
        data-chambre={chart.chambre}
        viewBox={`0 0 ${chart.layout.width} ${chart.layout.height}`}
        width={chart.layout.width}
        height={chart.layout.height}
        hidden={!chart.isActive}
        aria-hidden="true"
      >
        {chart.layout.points.map((point, index) => (
          <rect
            class="hemicycle__dot"
            data-index={index}
            data-vote={point.category}
            x={point.x - DOT_SIZE / 2}
            y={point.y - DOT_SIZE / 2}
            width={DOT_SIZE}
            height={DOT_SIZE}
          />
        ))}
      </svg>
    ))}

    <div class="hemicycle__label">
      <p class="hemicycle__seats" id="hemicycle-seats">{activeVote.totalSieges}</p>
      <p class="hemicycle__caption">sièges</p>
      <p class="hemicycle__majority" id="hemicycle-majority">Majorité à {seuilMajorite(activeVote.totalSieges)}</p>
    </div>
  </div>

  <p class="visually-hidden" id="hemicycle-summary">
    {activeVote.pour} pour, {activeVote.contre} contre, {activeVote.abstention} abstentions sur {activeVote.totalSieges} sièges.
  </p>
</div>

<style>
  .hemicycle {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .hemicycle__chart {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    padding: var(--space-md) var(--space-sm) 0;
    background: white;
    /* Ordre CSS : haut-gauche, haut-droit, bas-droit, bas-gauche. Les coins du HAUT
       doivent être pleinement arrondis (silhouette en dôme, node Figma 2583:18159) ;
       c'était inversé avant (bas totalement arrondi) — pile là où les rangées les
       plus larges de l'hémicycle touchent le bord, d'où les points qui semblaient
       déborder. overflow:hidden en garde-fou pour clipper au dôme dans tous les cas. */
    border-radius: var(--radius-full) var(--radius-full) 20px 20px;
    overflow: hidden;
  }

  .hemicycle__svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    /* min-width:0 : sans ça, un <svg> sans attributs width/height explicites peut
       avoir une taille intrinsèque ambiguë selon le navigateur (parfois ~300px de
       large par défaut), et l'auto-minimum des enfants flex empêche alors le
       width:100% de le faire rétrécir — d'où le dataviz qui débordait largement de
       son fond blanc. Les attributs width/height posés sur le <svg> (voir le
       markup) fixent le vrai problème ; ce min-width:0 est une garde-fou en plus. */
    min-width: 0;
  }

  .hemicycle__svg[hidden] {
    display: none;
  }

  .hemicycle__dot[data-vote='pour'] {
    fill: var(--color-success-on-light);
    clip-path: circle(50% at 50% 50%);
  }

  .hemicycle__dot[data-vote='contre'] {
    fill: var(--color-error-on-light);
    clip-path: none;
  }

  .hemicycle__dot[data-vote='abstention'] {
    fill: var(--color-warning-on-light);
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .hemicycle__dot[data-vote='non-votant'] {
    fill: white;
    stroke: var(--color-border-neutral-secondary);
    stroke-width: 1;
    clip-path: circle(50% at 50% 50%);
  }

  .hemicycle__label {
    position: absolute;
    left: 50%;
    bottom: var(--space-sm);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hemicycle__seats {
    font-family: var(--font-heading);
    font-size: var(--text-h2);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .hemicycle__caption {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    color: var(--color-text-default);
    margin: 0;
  }

  .hemicycle__majority {
    font-family: var(--font-body);
    font-size: var(--text-body-xsmall);
    color: var(--color-text-dark-grey);
    margin: var(--space-4xs) 0 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
