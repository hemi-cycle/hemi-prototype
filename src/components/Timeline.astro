---
// "On rembobine !" — frise du parcours législatif (US-6 backlog).
// Le composant "Law Timeline Item" (Figma node 2962:17553) précise sa propre règle
// d'usage : 4 items max affichés par défaut, sinon le surplus est replié derrière un
// item "Collapsed" (bouton pilule) qui se déplie au clic — implémenté ici en natif
// <details>/<summary>, zéro JS. Toujours visibles : le 1er et le dernier step.
import TimelineItem from './TimelineItem.astro';
import Icon from './Icon.astro';

interface Etape {
  date: string;
  chambre: string;
  libelle: string;
  statut: string;
  source?: string;
}

interface Props {
  etapes: Etape[];
}

const { etapes } = Astro.props;

const MAX_VISIBLE = 4;
const shouldCollapse = etapes.length > MAX_VISIBLE;
const first = etapes[0];
const last = etapes[etapes.length - 1];
const middle = shouldCollapse ? etapes.slice(1, -1) : [];
---

<div class="timeline">
  {shouldCollapse ? (
    <>
      <TimelineItem etape={first} hasLine={true} />

      <div class="timeline-item">
        <div class="timeline-item__marker">
          <span class="timeline-item__dot timeline-item__dot--done">
            <Icon name="check" size={12} color="white" />
          </span>
          <span class="timeline-item__line timeline-item__line--done"></span>
        </div>
        <details class="timeline-collapse">
          <summary class="timeline-collapse__toggle">
            Voir les {middle.length} étapes intermédiaires
          </summary>
          <div class="timeline-collapse__items">
            {middle.map((etape) => (
              <TimelineItem etape={etape} hasLine={true} />
            ))}
          </div>
        </details>
      </div>

      <TimelineItem etape={last} hasLine={false} />
    </>
  ) : (
    etapes.map((etape, index) => <TimelineItem etape={etape} hasLine={index < etapes.length - 1} />)
  )}
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
  }

  .timeline-item {
    display: flex;
    gap: var(--space-3xs);
  }

  .timeline-item__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding: var(--space-3xs) 0;
  }

  .timeline-item__dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .timeline-item__dot--done {
    background: var(--color-brand-darker);
  }

  .timeline-item__line {
    width: 2px;
    flex: 1;
    margin: var(--space-4xs) 0;
  }

  .timeline-item__line--done {
    background: var(--color-brand-darker);
  }

  .timeline-collapse {
    flex: 1;
    min-width: 0;
  }

  .timeline-collapse__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 var(--space-xs);
    border-radius: var(--radius-extra-large);
    background: var(--color-brand-darker);
    color: var(--color-brand-on-darker);
    font-family: var(--font-accent);
    font-size: var(--text-body-small);
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    list-style: none;
  }

  .timeline-collapse__toggle::-webkit-details-marker {
    display: none;
  }

  .timeline-collapse[open] .timeline-collapse__toggle {
    display: none;
  }

  .timeline-collapse__items {
    display: flex;
    flex-direction: column;
  }
</style>
