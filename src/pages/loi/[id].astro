---
// Page détail loi — Figma node 2583:17955. Sections sans donnée/asset réel disponible
// sont omises et documentées dans README.md (§ Roadmap) plutôt qu'inventées : pas de
// photo de couverture, pas de répartition soutiens/opposants par parti, pas de vidéos
// de discours, pas de visualisation hémicycle (US-8, déjà reportée).
//
// Structure : chaque section est une carte (bg neutral/primary, radius-small) posée
// sur le canevas de page (bg neutral/secondary) — l'écart de ~8px entre les cartes
// (`.page` gap) laisse volontairement le fond de page transparaître, comme sur le
// Figma. Le titre et "Déposé par" forment UNE seule carte séparée par un Divider,
// pas deux cartes distinctes (vérifié sur le node 2583:17970).
import MobileLayout from '../../layouts/MobileLayout.astro';
import Icon from '../../components/Icon.astro';
import Divider from '../../components/Divider.astro';
import LawStateTag from '../../components/LawStateTag.astro';
import Avatar from '../../components/Avatar.astro';
import ArgumentsList from '../../components/ArgumentsList.astro';
import KeyNumber from '../../components/KeyNumber.astro';
import WikiLink from '../../components/WikiLink.astro';
import Timeline from '../../components/Timeline.astro';
import loi from '../../data/loi-duplomb-menonville.json';

export function getStaticPaths() {
  return [{ params: { id: loi.id } }];
}

const base = import.meta.env.BASE_URL;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}

const vote = loi.votes[0];
---

<MobileLayout title={loi.titre_usuel}>
  <header class="hero">
    <a href={base} class="hero__back">
      <Icon name="arrow-left" size={20} />
      Retour
    </a>
  </header>

  <div class="page">
    <section class="card">
      <div class="title-block">
        <div class="title-block__eyebrow">
          <span class="title-block__kind">Proposition de loi</span>
          <LawStateTag statut={loi.statut_actuel} />
        </div>
        <h1 class="title-block__title">{loi.titre_usuel}</h1>
        <p class="title-block__subtitle">{loi.sous_titre}</p>
      </div>

      <Divider />

      <div class="depositors-block">
        <h2 class="section__title section__title--label">Déposé par</h2>
        <div class="depositors">
          {loi.depose_par.map((personne, index) => (
            <>
              {index > 0 && <Divider />}
              <div class="depositor">
                <Avatar size={40} showBorder name={personne.nom} />
                <div class="depositor__content">
                  <p class="depositor__name">{personne.nom}</p>
                  <p class="depositor__role">{personne.fonction} · {personne.parti}</p>
                </div>
                <a href={personne.source} target="_blank" rel="noopener noreferrer" class="depositor__link" aria-label={`Fiche de ${personne.nom} sur senat.fr`}>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="section__title section__title--accent">En bref</h2>
      <details class="summary">
        <summary class="summary__toggle">
          <p class="summary__text">{loi.description}</p>
          <span class="summary__cta">Lire la suite</span>
        </summary>
      </details>
    </section>

    <ArgumentsList pour={loi.arguments_pour} contre={loi.arguments_contre} />

    <section class="card">
      <h2 class="section__title">Résultat du vote</h2>
      <div class="card__body">
        <p class="vote__meta">{vote.type} · {vote.chambre === 'assemblee_nationale' ? 'Assemblée nationale' : vote.chambre} · {formatDate(vote.date)}</p>
        <div class="vote__numbers">
          <KeyNumber value={vote.pour} label="Pour" state={vote.pour > vote.contre ? 'success' : 'default'} />
          <KeyNumber value={vote.contre} label="Contre" state={vote.contre > vote.pour ? 'failure' : 'default'} />
          <KeyNumber value={vote.abstention} label="Abstentions" />
        </div>
        <a href={vote.source} target="_blank" rel="noopener noreferrer" class="vote__source">
          Voir le détail du vote
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </section>

    <WikiLink question="Combien faut-il de votes pour qu'une loi passe ?" href={`${base}/antiseche`} />

    <section class="card">
      <h2 class="section__title">On rembobine !</h2>
      <div class="card__body">
        <Timeline etapes={loi.etapes} />
      </div>
    </section>

    <section class="card">
      <h2 class="section__title">Textes officiels</h2>
      <div class="sources">
        {loi.sources.map((source, index) => (
          <>
            {index > 0 && <Divider />}
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="source-item">
              <Icon name="file-text" size={24} color="var(--color-text-dark-grey)" />
              <div class="source-item__content">
                <span class="source-item__label">{source.label}</span>
                <span class="source-item__domain">{new URL(source.url).hostname}</span>
              </div>
              <Icon name="arrow-up-right" size={16} color="var(--color-text-dark-grey)" />
            </a>
          </>
        ))}
      </div>
    </section>
  </div>
</MobileLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-bg-neutral-secondary);
  }

  .hero__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) var(--space-2xs);
    border-radius: var(--radius-small);
    background: var(--color-bg-neutral-secondary);
    box-shadow: var(--elevation-2);
    font-family: var(--font-accent);
    font-size: var(--text-body-xsmall);
    font-weight: 500;
    color: var(--color-text-default);
    text-decoration: none;
  }

  .page {
    padding: var(--space-xs);
    background: var(--color-bg-neutral-secondary);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-bg-neutral-primary);
    border-radius: var(--radius-small);
    padding: var(--space-sm) 0 var(--space-md);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0 var(--space-xs);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0 var(--space-xs);
  }

  .title-block__eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .title-block__kind {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    color: var(--color-text-dark-grey);
  }

  .title-block__title {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .title-block__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    color: var(--color-text-default);
    margin: 0;
  }

  .depositors-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .section__title {
    font-family: var(--font-heading);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
    padding: 0 var(--space-xs);
  }

  .section__title--label {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-text-dark-grey);
  }

  .section__title--accent {
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    font-weight: 500;
    color: var(--color-brand-darker);
  }

  .depositors {
    display: flex;
    flex-direction: column;
  }

  .depositor {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 48px;
    padding: var(--space-2xs) var(--space-xs);
  }

  .depositor__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .depositor__name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-default);
    margin: 0;
  }

  .depositor__role {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-dark-grey);
    margin: 0;
  }

  .depositor__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    color: var(--color-text-brand);
    flex-shrink: 0;
  }

  .summary {
    padding: 0 var(--space-xs);
  }

  .summary__toggle {
    cursor: pointer;
    list-style: none;
  }

  .summary__toggle::-webkit-details-marker {
    display: none;
  }

  .summary__text {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    line-height: 20px;
    color: var(--color-text-default);
    margin: 0 0 var(--space-2xs);
  }

  .summary:not([open]) .summary__text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .summary__cta {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-default);
    text-decoration: underline;
  }

  .summary[open] .summary__cta {
    display: none;
  }

  .vote__meta {
    font-family: var(--font-body);
    font-size: var(--text-body-xsmall);
    color: var(--color-text-dark-grey);
    margin: 0;
  }

  .vote__numbers {
    display: flex;
    gap: 1px;
    background: var(--color-bg-neutral-tertiary);
    border-radius: var(--radius-extra-small);
    overflow: hidden;
  }

  .vote__source {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4xs);
    font-family: var(--font-accent);
    font-size: var(--text-body-xsmall);
    font-weight: 500;
    color: var(--color-text-brand);
    text-decoration: none;
  }

  .sources {
    display: flex;
    flex-direction: column;
  }

  .source-item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 48px;
    padding: var(--space-2xs) var(--space-xs);
    text-decoration: none;
  }

  .source-item__content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .source-item__label {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-default);
    text-decoration: underline;
  }

  .source-item__domain {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-dark-grey);
  }
</style>
