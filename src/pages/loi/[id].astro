---
// Page détail loi — Figma node 2583:17955. Sections sans donnée/asset réel disponible
// sont omises et documentées dans README.md (§ Roadmap) plutôt qu'inventées : pas de
// photo de couverture, pas de répartition soutiens/opposants par parti, pas de vidéos
// de discours, pas de visualisation hémicycle (US-8, déjà reportée).
//
// Structure : chaque section est une carte (bg neutral/primary, radius-small) posée
// sur le canevas de page (bg neutral/secondary) — l'écart de ~8px entre les cartes
// (`.page` gap) laisse volontairement le fond de page transparaître, comme sur le
// Figma. Le titre et "Déposé par" forment UNE seule carte séparée par un Divider,
// pas deux cartes distinctes (vérifié sur le node 2583:17970).
import MobileLayout from '../../layouts/MobileLayout.astro';
import Icon from '../../components/Icon.astro';
import Divider from '../../components/Divider.astro';
import LawStateTag from '../../components/LawStateTag.astro';
import Avatar from '../../components/Avatar.astro';
import ArgumentsList from '../../components/ArgumentsList.astro';
import KeyNumber from '../../components/KeyNumber.astro';
import WikiLink from '../../components/WikiLink.astro';
import Timeline from '../../components/Timeline.astro';
import VotesTimeline from '../../components/VotesTimeline.astro';
import HemicycleChartV2 from '../../components/HemicycleChartV2.astro';
import loi from '../../data/loi-duplomb-menonville.json';
import { votesMock } from '../../data/votes-mock';

export function getStaticPaths() {
  return [{ params: { id: loi.id } }];
}

const base = import.meta.env.BASE_URL;

const chambreLabels: Record<string, string> = {
  senat: 'Sénat',
  assemblee_nationale: 'Assemblée nationale',
};

function seuilMajorite(totalSieges: number) {
  return Math.floor(totalSieges / 2) + 1;
}

// Vote actif par défaut à l'affichage : le dernier de la liste (ici la seule donnée
// réellement sourcée — voir "MD plans/Hemi_Plan_Votes_Hemicycle.md" §1).
const activeVote = votesMock[votesMock.length - 1];
---

<MobileLayout title={loi.titre_usuel}>
  <header class="hero">
    <a href={base} class="hero__back">
      <Icon name="arrow-left" size={20} />
      Retour
    </a>
  </header>

  <div class="page">
    <section class="introduction">
      <div class="title-block">
        <div class="title-block__eyebrow">
          <span class="title-block__kind">Proposition de loi</span>
          <LawStateTag statut={loi.statut_actuel} />
        </div>
        <h1 class="title-block__title">{loi.titre_usuel}</h1>
        <p class="title-block__subtitle">{loi.sous_titre}</p>
      </div>

      <Divider />

      <div class="depositors-block">
        <h2 class="section__title section__title--label">Déposé par</h2>
        <div class="depositors">
          {loi.depose_par.map((personne, index) => (
            <>
              {index > 0 && <Divider />}
              <div class="depositor">
                <Avatar size={40} showBorder name={personne.nom} />
                <div class="depositor__content">
                  <p class="depositor__name">{personne.nom}</p>
                  <p class="depositor__role">{personne.fonction} · {personne.parti}</p>
                </div>
                <a href={personne.source} target="_blank" rel="noopener noreferrer" class="depositor__link" aria-label={`Fiche de ${personne.nom} sur senat.fr`}>
                  <!-- Logo du parti : placeholder monogramme pour l'instant, à remplacer par les
                       vrais logos (src/assets/logos_partis/) une fois le mapping fait proprement. -->
                  <Avatar size={40} showBorder name={personne.parti} />
                </a>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="section__title section__title--accent">En bref</h2>
      <details class="summary">
        <summary class="summary__toggle">
          <p class="summary__text">{loi.description}</p>
          <span class="summary__cta">Lire la suite</span>
        </summary>
      </details>
    </section>

    <ArgumentsList pour={loi.arguments_pour} contre={loi.arguments_contre} />

    <section class="votes-card">
      <VotesTimeline etapes={loi.etapes} votes={votesMock} activeVoteId={activeVote.id} />

      <div class="votes-result">
        <HemicycleChartV2 votes={votesMock} activeVoteId={activeVote.id} />

        <div class="votes-footer">
          <div class="votes-footer__title">
            <p id="vote-chambre-title">{chambreLabels[activeVote.chambre]}</p>
            <p id="vote-majority" class="votes-footer__majority">Majorité à {seuilMajorite(activeVote.totalSieges)}</p>
          </div>
          <div class="votes-footer__numbers">
            <KeyNumber theme="on-dark" valueId="vote-pour" value={activeVote.pour} label="Pour" state="success" dotShape="circle" />
            <KeyNumber theme="on-dark" valueId="vote-contre" value={activeVote.contre} label="Contre" state="failure" dotShape="square" />
            <KeyNumber theme="on-dark" valueId="vote-abstention" value={activeVote.abstention} label="Abstentions" state="warning" dotShape="triangle" />
            <KeyNumber theme="on-dark" valueId="vote-non-votant" value={activeVote.nonVotant} label="Non-votants" dotShape="circle" />
          </div>
          <a
            href={activeVote.source || undefined}
            target={activeVote.source ? '_blank' : undefined}
            rel={activeVote.source ? 'noopener noreferrer' : undefined}
            class="votes-footer__button"
            id="vote-source"
          >
            {activeVote.source ? 'Voir + en détails' : 'Donnée provisoire — à confirmer'}
          </a>
        </div>
      </div>

      <WikiLink question="Combien faut-il de votes pour qu'une loi passe ?" href={`${base}/antiseche`} />
    </section>

    <section class="timeline-section">
      <h2 class="timeline-section__title">On rembobine !</h2>
      <Timeline etapes={loi.etapes} />
    </section>

    <section class="card">
      <h2 class="section__title">Textes officiels</h2>
      <div class="sources">
        {loi.sources.map((source, index) => (
          <>
            {index > 0 && <Divider />}
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="source-item">
              <Icon name="file-text" size={24} color="var(--color-text-dark-grey)" />
              <div class="source-item__content">
                <span class="source-item__label">{source.label}</span>
                <span class="source-item__domain">{new URL(source.url).hostname}</span>
              </div>
              <Icon name="arrow-up-right" size={16} color="var(--color-text-dark-grey)" />
            </a>
          </>
        ))}
      </div>
    </section>
  </div>
</MobileLayout>

<script>
  // Seul endroit du prototype qui nécessite du JS côté client — voir
  // "MD plans/Hemi_Plan_Votes_Hemicycle.md" §6. La géométrie des points de
  // l'hémicycle est calculée une fois au build (voir HemicycleChartV2.astro) ; ce
  // script se contente, au clic sur une étape de VotesTimeline, de changer
  // l'attribut `data-vote` des points déjà positionnés et de mettre à jour les
  // textes (chart label, footer "Résultat du vote"). Pas de recalcul de layout.
  import { categorizeSeatsByWedge } from '../../lib/hemicycle-layout-v2';

  const chambreLabels: Record<string, string> = {
    senat: 'Sénat',
    assemblee_nationale: 'Assemblée nationale',
  };

  function seuilMajorite(totalSieges: number) {
    return Math.floor(totalSieges / 2) + 1;
  }

  const timelineItems = document.querySelectorAll<HTMLButtonElement>('.vote-timeline-toggle');
  const chambreTitle = document.getElementById('vote-chambre-title');
  const voteMajority = document.getElementById('vote-majority');
  const svgsV2 = document.querySelectorAll<SVGSVGElement>('.hemicycle-v2__svg');
  const seatsLabelV2 = document.getElementById('hemicycle-v2-seats');
  const votePour = document.getElementById('vote-pour');
  const voteContre = document.getElementById('vote-contre');
  const voteAbstention = document.getElementById('vote-abstention');
  const voteNonVotant = document.getElementById('vote-non-votant');
  const voteSource = document.getElementById('vote-source') as HTMLAnchorElement | null;

  timelineItems.forEach((item) => {
    item.addEventListener('click', () => {
      const { chambre = '', totalSieges, pour, contre, abstention, nonVotant, source } = item.dataset;
      const total = Number(totalSieges);
      const counts = {
        pour: Number(pour),
        contre: Number(contre),
        abstention: Number(abstention),
        nonVotant: Number(nonVotant),
      };

      timelineItems.forEach((other) => {
        other.dataset.active = other === item ? 'true' : 'false';
      });

      svgsV2.forEach((svg) => {
        const isMatch = svg.dataset.chambre === chambre;
        svg.toggleAttribute('hidden', !isMatch);
        if (isMatch) {
          const categoriesV2 = categorizeSeatsByWedge(total, counts);
          svg.setAttribute(
            'aria-label',
            `Hémicycle : ${counts.pour} pour, ${counts.contre} contre, ${counts.abstention} abstentions, ${counts.nonVotant} non-votants sur ${total} sièges.`
          );
          svg.querySelectorAll<SVGRectElement>('.hemicycle-v2__dot').forEach((dot, index) => {
            const category = categoriesV2[index];
            dot.setAttribute('data-vote', category);
            const title = dot.querySelector('title');
            if (title) title.textContent = `Siège ${index + 1} — ${category}`;
          });
        }
      });

      if (seatsLabelV2) seatsLabelV2.textContent = String(total);

      if (chambreTitle) chambreTitle.textContent = chambreLabels[chambre] ?? chambre;
      if (voteMajority) voteMajority.textContent = `Majorité à ${seuilMajorite(total)}`;

      if (votePour) votePour.textContent = String(counts.pour);
      if (voteContre) voteContre.textContent = String(counts.contre);
      if (voteAbstention) voteAbstention.textContent = String(counts.abstention);
      if (voteNonVotant) voteNonVotant.textContent = String(counts.nonVotant);

      if (voteSource) {
        if (source) {
          voteSource.href = source;
          voteSource.target = '_blank';
          voteSource.rel = 'noopener noreferrer';
          voteSource.textContent = 'Voir + en détails';
        } else {
          voteSource.removeAttribute('href');
          voteSource.removeAttribute('target');
          voteSource.removeAttribute('rel');
          voteSource.textContent = 'Donnée provisoire — à confirmer';
        }
      }
    });
  });
</script>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-bg-neutral-secondary);
  }

  .hero__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-xs) var(--space-2xs) var(--space-2xs);
    border-radius: var(--radius-small);
    background: var(--color-bg-neutral-secondary);
    box-shadow: var(--elevation-2);
    font-family: var(--font-accent);
    font-size: var(--text-body-xsmall);
    font-weight: 500;
    color: var(--color-text-default);
    text-decoration: none;
  }

  .page {
    padding: var(--space-xs) var(--space-none);
    background: var(--color-bg-neutral-secondary);
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-bg-neutral-primary);
    border-radius: var(--radius-small);
    padding: var(--space-sm) 0 var(--space-md);
  }

  .timeline-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    background: var(--color-bg-neutral-primary);
    border-radius: var(--radius-small);
    padding: var(--space-md) var(--space-xs) var(--space-lg);
  }

  .timeline-section__title {
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .introduction {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    background: var(--color-bg-neutral-primary);
    border-radius: var(--radius-small);
    padding: var(--space-sm) 0 var(--space-none);
  }

  .title-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: 0 var(--space-xs);
  }

  .title-block__eyebrow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
  }

  .title-block__kind {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    color: var(--color-text-dark-grey);
  }

  .title-block__title {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
  }

  .title-block__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 500;
    color: var(--color-text-default);
    margin: 0;
  }

  .depositors-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .section__title {
    font-family: var(--font-heading);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-default);
    margin: 0;
    padding: 0 var(--space-xs);
  }

  .section__title--label {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-text-dark-grey);
  }

  .section__title--accent {
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    font-weight: 500;
    color: var(--color-brand-darker);
  }

  .depositors {
    display: flex;
    flex-direction: column;
  }

  .depositor {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 48px;
    padding: var(--space-2xs) var(--space-xs);
  }

  .depositor__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1;
  }

  .depositor__name {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-default);
    margin: 0;
  }

  .depositor__role {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-dark-grey);
    margin: 0;
  }

  .depositor__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .summary {
    padding: 0 var(--space-xs);
  }

  .summary__toggle {
    cursor: pointer;
    list-style: none;
  }

  .summary__toggle::-webkit-details-marker {
    display: none;
  }

  .summary__text {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    line-height: 20px;
    color: var(--color-text-default);
    margin: 0 0 var(--space-2xs);
  }

  .summary:not([open]) .summary__text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .summary__cta {
    font-family: var(--font-body);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-default);
    text-decoration: underline;
  }

  .summary[open] .summary__cta {
    display: none;
  }

  .votes-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    background: var(--color-brand-darker);
    border-radius: var(--radius-small);
    padding: var(--space-xl) var(--space-xs);
  }

  .votes-result {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .votes-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .votes-footer__title {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    padding: var(--space-4xs) 0;
    background: var(--color-overlay-light-20);
    border: 0.5px solid var(--color-brand-darker);
    border-radius: var(--radius-extra-small);
  }

  .votes-footer__title p {
    /* min-width:0 est nécessaire : un enfant flex refuse par défaut de rétrécir
       sous sa largeur de contenu (min-width:auto), donc "Assemblée nationale" en
       nowrap débordait de la pilule au lieu de s'y tronquer. */
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-heading);
    font-size: var(--text-body-small);
    font-weight: 400;
    color: var(--color-text-white);
    margin: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .votes-footer__title p.votes-footer__majority {
    font-family: var(--font-body);
    font-size: var(--text-body-xsmall);
    font-weight: 400;
    opacity: 0.7;
  }

  .votes-footer__numbers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    width: 100%;
  }

  .votes-footer__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 39px;
    background: var(--color-overlay-light-20);
    border: 0.5px solid var(--color-brand-darker);
    border-radius: var(--radius-extra-small);
    font-family: var(--font-body);
    font-size: var(--text-body-medium);
    font-weight: 500;
    color: var(--color-text-white);
    text-decoration: none;
    text-align: center;
  }

  .sources {
    display: flex;
    flex-direction: column;
  }

  .source-item {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    min-height: 48px;
    padding: var(--space-2xs) var(--space-xs);
    text-decoration: none;
  }

  .source-item__content {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .source-item__label {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-default);
    text-decoration: underline;
  }

  .source-item__domain {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-dark-grey);
  }
</style>
