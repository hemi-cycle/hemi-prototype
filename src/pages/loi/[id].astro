---
// Page détail loi — Figma node 2583:17955. Sections sans donnée/asset réel disponible
// sont omises et documentées dans README.md (§ Roadmap) plutôt qu'inventées : pas de
// répartition soutiens/opposants par parti, pas de vidéos de discours, pas de
// visualisation hémicycle (US-8, déjà reportée).
//
// Structure : chaque section est une carte (bg neutral/primary, radius-small) posée
// sur le canevas de page (bg neutral/secondary) — l'écart de ~8px entre les cartes
// (`.page` gap) laisse volontairement le fond de page transparaître, comme sur le
// Figma. Le titre et "Déposé par" forment UNE seule carte séparée par un Divider,
// pas deux cartes distinctes (vérifié sur le node 2583:17970).
import MobileLayout from '../../layouts/MobileLayout.astro';
import Icon from '../../components/Icon.astro';
import Divider from '../../components/Divider.astro';
import LawStateTag from '../../components/LawStateTag.astro';
import Avatar from '../../components/Avatar.astro';
import ArgumentsList from '../../components/ArgumentsList.astro';
import WikiLink from '../../components/WikiLink.astro';
import Timeline from '../../components/Timeline.astro';
import VotesTimeline from '../../components/VotesTimeline.astro';
import HemicycleChartV2 from '../../components/HemicycleChartV2.astro';
import VotesMajorityBar from '../../components/VotesMajorityBar.astro';
import { lois, type LoiEntry } from '../../lib/lois';

export function getStaticPaths() {
  return lois.map((entry) => ({ params: { id: entry.data.id }, props: { entry } }));
}

interface Props {
  entry: LoiEntry;
}

const { entry } = Astro.props;
const { data: loi, thumbnail, votes } = entry;

const base = import.meta.env.BASE_URL;

const chambreLabels: Record<string, string> = {
  senat: 'Sénat',
  assemblee_nationale: 'Assemblée nationale',
};

function seuilMajorite(totalSieges: number) {
  return Math.floor(totalSieges / 2) + 1;
}

function voteResultLabel(pour: number, totalSieges: number) {
  return pour >= seuilMajorite(totalSieges) ? { prefix: 'Le vote ', verb: 'passe' } : { prefix: 'Le vote est ', verb: 'rejeté' };
}

// Vote actif par défaut à l'affichage : le dernier de la liste (ici la seule donnée
// réellement sourcée — voir "MD plans/Hemi_Plan_Votes_Hemicycle.md" §1). null si la
// loi n'a encore fait l'objet d'aucun vote (ex. proposition encore en commission) :
// toute la section "Votes & Hémicycle" est alors omise plus bas.
const activeVote = votes.length > 0 ? votes[votes.length - 1] : null;
const activeVoteResult = activeVote ? voteResultLabel(activeVote.pour, activeVote.totalSieges) : null;
---

<MobileLayout title={loi.titre_usuel}>
  <header class="hero">
    <img src={thumbnail.src} alt="" class="hero__image" />
    <div class="hero__scrim"></div>
    <a href={base} class="hero__back">
      <Icon name="arrow-left" size={20} />
      Retour
    </a>
  </header>

  <div class="page">
    <section class="introduction">
      <div class="title-block">
        <div class="title-block__eyebrow">
          <span class="title-block__kind">Proposition de loi</span>
          <LawStateTag statut={loi.statut_actuel} />
        </div>
        <h1 class="title-block__title">{loi.titre_usuel}</h1>
        <p class="title-block__subtitle">{loi.sous_titre}</p>
      </div>

      <Divider />

      <div class="depositors-block">
        <h2 class="section__title section__title--label">Déposé par</h2>
        <div class="depositors">
          {loi.depose_par.map((personne, index) => (
            <>
              {index > 0 && <Divider />}
              <div class="depositor">
                <Avatar size={40} showBorder name={personne.nom} />
                <div class="depositor__content">
                  <p class="depositor__name">{personne.nom}</p>
                  <p class="depositor__role">{personne.fonction} · {personne.parti}</p>
                </div>
                <a href={personne.source} target="_blank" rel="noopener noreferrer" class="depositor__link" aria-label={`Fiche de ${personne.nom} sur senat.fr`}>
                  <!-- Logo du parti : placeholder monogramme pour l'instant, à remplacer par les
                       vrais logos (src/assets/logos_partis/) une fois le mapping fait proprement. -->
                  <Avatar size={40} showBorder name={personne.parti} />
                </a>
              </div>
            </>
          ))}
        </div>
      </div>
    </section>

    <section class="card">
      <h2 class="section__title section__title--accent">En bref</h2>
      <details class="summary">
        <summary class="summary__toggle">
          <p class="summary__text">{loi.description}</p>
          <span class="summary__cta">Lire la suite</span>
        </summary>
      </details>
    </section>

    <ArgumentsList pour={loi.arguments_pour} contre={loi.arguments_contre} />

    {activeVote && activeVoteResult && (
      <section class="votes-card">
        <VotesTimeline etapes={loi.etapes} votes={votes} activeVoteId={activeVote.id} />

        <div class="votes-result">
          <div class="votes-header__title">
            <h3 id="vote-chambre-title">{chambreLabels[activeVote.chambre]}</h3>
            <p id="vote-result" class="votes-header__result"><span id="vote-result-prefix">{activeVoteResult.prefix}</span><strong id="vote-result-verb">{activeVoteResult.verb}</strong></p>
          </div>

          <HemicycleChartV2 votes={votes} activeVoteId={activeVote.id} />

          <VotesMajorityBar votes={votes} activeVoteId={activeVote.id} />

          <div class="votes-footer">
            <a
              href={activeVote.source || undefined}
              target={activeVote.source ? '_blank' : undefined}
              rel={activeVote.source ? 'noopener noreferrer' : undefined}
              class="votes-footer__button"
              id="vote-source"
            >
              {activeVote.source ? 'Voir + en détails' : 'Donnée provisoire — à confirmer'}
            </a>
          </div>
        </div>

        <WikiLink question="Combien faut-il de votes pour qu'une loi passe ?" href={`${base}/antiseche`} />
      </section>
    )}

    <section class="timeline-section">
      <h2 class="timeline-section__title">On rembobine !</h2>
      <Timeline etapes={loi.etapes} />
    </section>

    <section class="card">
      <h2 class="section__title">Textes officiels</h2>
      <div class="sources">
        {loi.sources.map((source, index) => (
          <>
            {index > 0 && <Divider />}
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="source-item">
              <Icon name="file-text" size={24} color="var(--color-text-dark-grey)" />
              <div class="source-item__content">
                <span class="source-item__label">{source.label}</span>
                <span class="source-item__domain">{new URL(source.url).hostname}</span>
              </div>
              <Icon name="arrow-up-right" size={16} color="var(--color-text-dark-grey)" />
            </a>
          </>
        ))}
      </div>
    </section>
  </div>
</MobileLayout>

<script>
  // Seul endroit du prototype qui nécessite du JS côté client — voir
  // "MD plans/Hemi_Plan_Votes_Hemicycle.md" §6. La géométrie des points de
  // l'hémicycle est calculée une fois au build (voir HemicycleChartV2.astro) ; ce
  // script se contente, au clic sur une étape de VotesTimeline, de changer
  // l'attribut `data-vote` des points déjà positionnés et de mettre à jour les
  // textes (chart label, footer "Résultat du vote"). Pas de recalcul de layout.
  import { categorizeSeatsByWedge } from '../../lib/hemicycle-layout-v2';

  const chambreLabels: Record<string, string> = {
    senat: 'Sénat',
    assemblee_nationale: 'Assemblée nationale',
  };

  function seuilMajorite(totalSieges: number) {
    return Math.floor(totalSieges / 2) + 1;
  }

  function voteResultLabel(pour: number, totalSieges: number) {
    return pour >= seuilMajorite(totalSieges) ? { prefix: 'Le vote ', verb: 'passe' } : { prefix: 'Le vote est ', verb: 'rejeté' };
  }

  const timelineItems = document.querySelectorAll<HTMLButtonElement>('.vote-timeline-toggle');
  const chambreTitle = document.getElementById('vote-chambre-title');
  const voteResultPrefix = document.getElementById('vote-result-prefix');
  const voteResultVerb = document.getElementById('vote-result-verb');
  const svgsV2 = document.querySelectorAll<SVGSVGElement>('.hemicycle-v2__svg');
  const seatsLabelV2 = document.getElementById('hemicycle-v2-seats');
  const voteSource = document.getElementById('vote-source') as HTMLAnchorElement | null;
  const majorityBarPour = document.getElementById('majority-bar-pour');
  const majorityBarAbstention = document.getElementById('majority-bar-abstention');
  const majorityBarNonVotant = document.getElementById('majority-bar-non-votant');
  const majorityBarContre = document.getElementById('majority-bar-contre');
  const majorityBarMarker = document.getElementById('majority-bar-marker');
  const majorityBarPourValue = document.getElementById('majority-bar-pour-value');
  const majorityBarContreValue = document.getElementById('majority-bar-contre-value');
  const majorityBarAbstentionValue = document.getElementById('majority-bar-abstention-value');
  const majorityBarNonVotantValue = document.getElementById('majority-bar-non-votant-value');

  timelineItems.forEach((item) => {
    item.addEventListener('click', () => {
      const { chambre = '', totalSieges, pour, contre, abstention, nonVotant, source } = item.dataset;
      const total = Number(totalSieges);
      const counts = {
        pour: Number(pour),
        contre: Number(contre),
        abstention: Number(abstention),
        nonVotant: Number(nonVotant),
      };

      timelineItems.forEach((other) => {
        other.dataset.active = other === item ? 'true' : 'false';
      });

      svgsV2.forEach((svg) => {
        const isMatch = svg.dataset.chambre === chambre;
        svg.toggleAttribute('hidden', !isMatch);
        if (isMatch) {
          const categoriesV2 = categorizeSeatsByWedge(total, counts);
          svg.setAttribute(
            'aria-label',
            `Hémicycle : ${counts.pour} pour, ${counts.contre} contre, ${counts.abstention} abstentions, ${counts.nonVotant} non-votants sur ${total} sièges.`
          );
          svg.querySelectorAll<SVGCircleElement>('.hemicycle-v2__dot').forEach((dot, index) => {
            const category = categoriesV2[index];
            dot.setAttribute('data-vote', category);
            const title = dot.querySelector('title');
            if (title) title.textContent = `Siège ${index + 1} — ${category}`;
          });
        }
      });

      if (seatsLabelV2) seatsLabelV2.textContent = String(total);

      if (chambreTitle) chambreTitle.textContent = chambreLabels[chambre] ?? chambre;
      const result = voteResultLabel(counts.pour, total);
      if (voteResultPrefix) voteResultPrefix.textContent = result.prefix;
      if (voteResultVerb) voteResultVerb.textContent = result.verb;

      const majorite = seuilMajorite(total);
      const pourPct = (counts.pour / total) * 100;
      const abstentionPct = (counts.abstention / total) * 100;
      const nonVotantPct = (counts.nonVotant / total) * 100;
      const contrePct = (counts.contre / total) * 100;
      if (majorityBarPour) {
        majorityBarPour.style.left = '0%';
        majorityBarPour.style.width = `${pourPct}%`;
      }
      if (majorityBarAbstention) {
        majorityBarAbstention.style.left = `${pourPct}%`;
        majorityBarAbstention.style.width = `${abstentionPct}%`;
      }
      if (majorityBarNonVotant) {
        majorityBarNonVotant.style.left = `${pourPct + abstentionPct}%`;
        majorityBarNonVotant.style.width = `${nonVotantPct}%`;
      }
      if (majorityBarContre) {
        majorityBarContre.style.left = `${pourPct + abstentionPct + nonVotantPct}%`;
        majorityBarContre.style.width = `${contrePct}%`;
      }
      if (majorityBarMarker) majorityBarMarker.style.left = `${(majorite / total) * 100}%`;
      if (majorityBarPourValue) majorityBarPourValue.textContent = String(counts.pour);
      if (majorityBarContreValue) majorityBarContreValue.textContent = String(counts.contre);
      if (majorityBarAbstentionValue) majorityBarAbstentionValue.textContent = String(counts.abstention);
      if (majorityBarNonVotantValue) majorityBarNonVotantValue.textContent = String(counts.nonVotant);

      if (voteSource) {
        if (source) {
          voteSource.href = source;
          voteSource.target = '_blank';
          voteSource.rel = 'noopener noreferrer';
          voteSource.textContent = 'Voir + en détails';
        } else {
          voteSource.removeAttribute('href');
          voteSource.removeAttribute('target');
          voteSource.removeAttribute('rel');
          voteSource.textContent = 'Donnée provisoire — à confirmer';
        }
      }
    });
  });
</script>

