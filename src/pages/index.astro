---
import MobileLayout from '../layouts/MobileLayout.astro';
import LawCard from '../components/LawCard.astro';
import loi from '../data/loi-duplomb-menonville.json';
---

<MobileLayout title="À la une">
  <div class="page">
    <h1 class="page__title">À la une</h1>
    <div class="law-list">
      <LawCard id={loi.id} titre={loi.titre_usuel} sousTitre={loi.sous_titre} statut={loi.statut_actuel} />
    </div>
  </div>
</MobileLayout>

<style>
  .page {
    padding: var(--space-xs);
  }

  .page__title {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 400;
    color: var(--color-text-default);
    margin: var(--space-2xs) 0 var(--space-md);
  }

  .law-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
</style>
