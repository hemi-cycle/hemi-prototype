---
import MobileLayout from '../layouts/MobileLayout.astro';
import LawList from '../components/LawList.astro';
import loi from '../data/loi-duplomb-menonville.json';

const premierDeposant = loi.depose_par[0];

const laws = [
  {
    id: loi.id,
    titre: loi.titre_usuel,
    sousTitre: loi.sous_titre,
    statut: loi.statut_actuel,
    deposantNom: premierDeposant.nom,
    deposantRole: `${premierDeposant.fonction} · ${premierDeposant.parti}`,
  },
];
---

<MobileLayout title="À la une">
  <div class="page">
    <h1 class="page__title">À la une</h1>
    <LawList laws={laws} />
  </div>
</MobileLayout>

<style>
  .page {
    padding: var(--space-xs);
  }

  .page__title {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 400;
    color: var(--color-text-default);
    margin: var(--space-2xs) 0 var(--space-md);
  }
</style>
