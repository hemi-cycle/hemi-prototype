---
import MobileLayout from '../layouts/MobileLayout.astro';
import LawList from '../components/LawList.astro';
import { lois } from '../lib/lois';

const laws = lois.map(({ data, thumbnail }) => {
  const premierDeposant = data.depose_par[0];
  return {
    id: data.id,
    titre: data.titre_usuel,
    sousTitre: data.sous_titre,
    statut: data.statut_actuel,
    deposantNom: premierDeposant.nom,
    deposantRole: `${premierDeposant.fonction} · ${premierDeposant.parti}`,
    partiNom: premierDeposant.parti,
    imageSrc: thumbnail,
  };
});
---

<MobileLayout title="À la une">
  <div class="page">
    <h1 class="page__title">À la une</h1>
    <LawList laws={laws} />
  </div>
</MobileLayout>

<style>
  .page {
    padding: var(--space-xs);
  }

  .page__title {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 400;
    color: var(--color-text-default);
    margin: var(--space-2xs) 0 var(--space-md);
  }
</style>
